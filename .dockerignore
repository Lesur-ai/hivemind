# Deployment secrets, local worktrees, and host-built caches must never enter
# a Docker build context. Keep the root and recursive forms explicit: Docker's
# pattern matcher does not make a top-level pattern a recursive guarantee.
.git
.git/**
.claude
.claude/**
.codex
.codex/**
.env
.env.*
**/.env
**/.env.*
*.key
**/*.key
*.pem
**/*.pem
.venv
**/.venv
.venv-tests
**/.venv-tests
venv
**/venv
env
**/env
.tox
**/.tox
__pycache__
**/__pycache__
**/*.py[cod]
.pytest_cache
**/.pytest_cache
.mypy_cache
**/.mypy_cache
.ruff_cache
**/.ruff_cache
.coverage
.coverage.*
**/.coverage
**/.coverage.*
htmlcov
**/htmlcov
build
**/build
dist
**/dist
*.egg-info
**/*.egg-info
proof-artifacts
**/proof-artifacts
.provider-certification-owned
.provider-certification-budget
artifacts/provider-certification
chantier
**/chantier
memory-bank
**/memory-bank
.mcp.json
**/.mcp.json
