# ============================================================
# Hivemind MCP Server — Configuration
# Production template: copy this file to .env and set every required secret.
# For a local MinIO-backed evaluation, run instead:
#   python scripts/configure_dev_env.py
# The helper creates a mode-0600 .env with random bootstrap, MinIO, and Neo4j
# credentials. It never prints those credentials.
# ============================================================

# --- MCP Server ---
# MCP_SERVER_NAME is what clients see in the MCP `initialize` handshake.
# Public identity is "Hivemind" (ADR-0018); the internal Python module
# path stays `live_mem`.
MCP_SERVER_NAME=Hivemind
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8002
MCP_SERVER_DEBUG=false

# --- Auth ---
# Required: >= 32 random characters. Blank is intentionally fail-closed.
ADMIN_BOOTSTRAP_KEY=

# --- S3 ---
# Path-style mandatory. These three values are all required together.
# Local evaluation: configure_dev_env.py selects the Compose MinIO service.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Bucket default flipped to `hivemind` for fresh installs.
# Existing operators upgrading from the live-memory release MUST keep their
# previous bucket name (typically `live-mem`) to preserve all stored state.
# See docs/DEPLOYMENT.md "Upgrading from live-memory" for the full procedure.
S3_BUCKET_NAME=hivemind
S3_REGION_NAME=us-east-1

# S3 signature mode:
#   dual  (default) = SigV2 for PUT/GET/DELETE/COPY + SigV4 for HEAD/LIST.
#                      Required for Dell ECS Cloud Temple.
#   sigv4           = SigV4 for all operations.
#                      Required for MinIO (no SigV2), AWS S3 (SigV2 deprecated),
#                      and any modern S3-compatible provider.
S3_SIGNATURE_MODE=sigv4

# --- OpenAI-compatible LLM provider (required for mid and active long use) ---
# The consolidator uses an LLM to transform live notes into bank files.
# The API must expose OpenAI-compatible `/chat/completions` and `/embeddings`
# endpoints under this base URL. Mid consolidation and long extraction use the
# chat model; long ingestion/query use the embedding model.
#
# LLMAAS_API_URL      : LLM API URL. Must include /v1.
# LLMAAS_API_KEY      : API key for authentication.
# LLMAAS_MODEL        : Chat model name exactly as exposed by the provider.
#                        The shipped value is illustrative, not portable.
# LLMAAS_CONTEXT_WINDOW : TOTAL context window of the model (in tokens).
#                          This is the maximum capacity for input + output combined.
#                          Qwen 3.5 27B = 500000 tokens (500K). Do not exceed the value
#                          supported by the model — requests will be rejected.
# LLMAAS_MAX_TOKENS   : Maximum OUTPUT tokens requested per API call.
#                        This is the budget for the LLM response (not input).
#                        MUST be strictly less than LLMAAS_CONTEXT_WINDOW —
#                        startup fails otherwise with an error naming both
#                        variables and their effective values.
#                        The consolidator adjusts dynamically:
#                        output = min(LLMAAS_MAX_TOKENS, CONTEXT_WINDOW - estimated_input)
#                        Recommended: 200000 with a 500K context model.
# LLMAAS_TEMPERATURE  : LLM creativity (0.0 = deterministic, 1.0 = very creative).
#                        0.3 is a good balance for consolidation (precise but flexible).
#
LLMAAS_API_URL=
LLMAAS_API_KEY=
LLMAAS_MODEL=qwen3.5:27b
LLMAAS_CONTEXT_WINDOW=131072
LLMAAS_MAX_TOKENS=16384
LLMAAS_TEMPERATURE=0.3

# --- Outbound HTTP Proxy (optional) ---
# CUSTOM variable (not HTTP_PROXY/HTTPS_PROXY) to avoid affecting all
# Python libraries that automatically read OS env vars.
# Manually injected into boto3 (S3) and httpx (LLM consolidation calls and
# the lightweight LLM health probes of /health and system_health), and into
# the embedded Graph Memory Internet egress (extraction/embedding LLM calls
# with their provider-health probes, document-storage S3, shared token-store
# S3 reads) — the shared Compose env_file delivers this same value there.
# Always direct: the internal Hivemind->graph-memory MCP bridge, Neo4j,
# Qdrant, and container-local health checks. Proxy failure fails closed —
# no silent direct fallback. Leave empty or undefined for direct access.
# The URL may carry credentials (http://user:pass@host:port); logs, health
# output, and errors only ever show the scheme://host:port origin.
#PROXY_URL=http://10.185.132.250:3128

# --- Default Rules ---
# Markdown file loaded when space_create is called without a rules parameter.
# The legacy filename `live-mem.standard.memory.bank.md` is retained for
# backward compatibility — renaming would silently break existing space_create
# calls and any operator override that points at the same path.
# In Docker: /app/RULES/live-mem.standard.memory.bank.md
# Locally:   RULES/live-mem.standard.memory.bank.md (relative to CWD)
DEFAULT_RULES_FILE=RULES/live-mem.standard.memory.bank.md

# --- Consolidation ---
# CONSOLIDATION_TIMEOUT    : Timeout per LLM call in seconds. 600s = 10 min.
# CONSOLIDATION_MAX_NOTES  : Max notes processed per consolidation.
#                             Beyond this, remaining notes wait for the next run.
# CONSOLIDATION_BATCH_SIZE : Number of notes sent to the LLM per batch.
#                             Small batches (2) = shorter JSON responses = less drift.
#                             Large batches (5) = fewer LLM calls = faster.
# CONSOLIDATION_COOLDOWN_SECONDS : Per-space anti-spam cooldown in seconds.
#                                  60s = ~1 consolidation/min/space. Set 0 to disable.
CONSOLIDATION_TIMEOUT=600
CONSOLIDATION_MAX_NOTES=200
CONSOLIDATION_BATCH_SIZE=5
CONSOLIDATION_COOLDOWN_SECONDS=60

# --- Bank Compaction ---
# Automatic compaction of oversized bank files before consolidation.
# When the bank consumes too much of the LLM context window, the largest
# files are summarized automatically via a dedicated LLM call.
#
# COMPACT_THRESHOLD    : Trigger threshold. If the bank exceeds this ratio
#                         of LLMAAS_MAX_TOKENS, compaction is triggered.
#                         0.6 = compact if bank uses > 60% of budget.
# BANK_FILE_MAX_SIZE   : Max size per bank file (in bytes). Files exceeding
#                         this limit are compaction candidates.
#                         15360 = 15 KB. Adjustable to your needs.
COMPACT_THRESHOLD=0.6
BANK_FILE_MAX_SIZE=15360

# --- Response / Admin API limits ---
# RESPONSE_MAX_BYTES        : Max response body size before truncation (512 KB).
# API_TOOL_MAX_BODY_BYTES   : Max request body accepted by /api/tool (1 MB).
# ADMIN_AUDIT_RING_SIZE     : Per-instance in-memory console/auth audit entries.
#                             Default 500; startup rejects values outside 1..500.
RESPONSE_MAX_BYTES=524288
API_TOOL_MAX_BODY_BYTES=1048576
ADMIN_AUDIT_RING_SIZE=500

# --- Project Mesh peer transport ---
# The application default is enabled and fails closed without a complete
# identity. This example explicitly selects a single-node deployment so a
# first local install is usable. To enable Mesh, set this to true and configure
# every identity value below. Generate an Ed25519 key locally with:
#   uv run python -m live_mem mesh-keygen --output ./mesh-identity.key
# The created file is mode 0600 and stdout contains public metadata only. Load
# its single private-key line into deployment secret configuration; never commit
# it, expose it through an API, or copy it into a shared memory space.
HIVEMIND_MESH_ENABLED=false
HIVEMIND_MESH_PUBLIC_URL=
HIVEMIND_MESH_PRIVATE_KEY=
HIVEMIND_MESH_DISPLAY_NAME=
# V1 limits are frozen. Values may be tightened only where documented; the
# defaults below are the maximum accepted startup values.
HIVEMIND_MESH_INVITATION_TTL_SECONDS=3600
HIVEMIND_MESH_CONTROL_MAX_BYTES=262144
HIVEMIND_MESH_BOOTSTRAP_MAX_BYTES=268435456
HIVEMIND_MESH_BOOTSTRAP_MAX_OBJECTS=50000

# --- WAF / Reverse Proxy ---
# Dev: SITE_ADDRESS=:8080 (HTTP, no TLS)
# Prod: SITE_ADDRESS=my-service.example.com (TLS via Let's Encrypt)
SITE_ADDRESS=:8080
WAF_PORT=8080

# ============================================================
# CLIENT CLI Configuration (do NOT put in this file)
# Use shell environment variables instead:
#   export MCP_URL=https://my-service.example.com
#   export MCP_TOKEN=my_secret_token
# ============================================================

# ===========================================================================
# S3 Server-Side Encryption (STRONGLY RECOMMENDED in production)
# ===========================================================================
# Empty / unset = no SSE (kept as the default to remain Dell ECS compatible).
# AES256       = SSE-S3 (S3-managed keys, no extra config) — recommended on
#                AWS S3 and any provider that honours the x-amz-server-side-
#                encryption request header.
# aws:kms      = SSE-KMS (requires S3_SSE_KMS_KEY_ID).
#
# Operators on AWS S3 should uncomment one of the two lines below.
# Dell ECS Cloud Temple users keep both lines commented (Hivemind detects
# the unsupported header and would otherwise refuse PUTs).
#S3_SSE=AES256
#S3_SSE_KMS_KEY_ID=arn:aws:kms:fr1:123:key/...

# ===========================================================================
# S3 bucket versioning (operator step — STRONGLY RECOMMENDED)
# ===========================================================================
# Bucket versioning is configured ON THE BUCKET ITSELF, not from this file.
# Hivemind backups rely on durable, append-only S3 state. Enabling bucket
# versioning gives operators a recovery path against accidental deletes
# or partial writes. Apply once at provisioning time:
#   AWS S3:     aws s3api put-bucket-versioning --bucket <name> --versioning-configuration Status=Enabled
#   Dell ECS:   enable versioning at the bucket level via the ECS portal
# See docs/DEPLOYMENT.md "Secure-by-default operator steps" for the full
# checklist.

# ===========================================================================
# Optional post-consolidation validation pass
# ===========================================================================
# When enabled, after each consolidated batch the server diffs the bank
# (before/after) and counts "claims" (numeric metrics, dates, versions,
# PR/issue refs, strong status keywords) introduced by the LLM that are
# neither sourced from a note in the batch nor explicitly tagged `[inféré]`.
# Pure code-only check (regex + line diff), no extra LLM call, deterministic.
# Result is reported in the `validation` field of the bank_consolidate
# response (and as a WARNING log if non-zero).
#
# Default OFF — opt-in for CI / observability deployments. Enabling has
# negligible cost (a few S3 reads per batch + regex on diff lines).
#CONSOLIDATION_VALIDATION_ENABLED=false
#
# Max number of unsourced-claim examples returned in the response
# (bounds the payload size). Default 20.
#CONSOLIDATION_VALIDATION_MAX_EXAMPLES=20

# ===========================================================================
# Embedded long runtime — Graph Memory + Neo4j + Qdrant (mandatory, ADR-0019)
# ===========================================================================
# The long ontology/knowledge-graph engine is a repository-shipped
# product component built by the DEFAULT compose stack — no operator-supplied
# long backend image, no separate provisioning. It runs on the internal
# Docker network with no host ports; only Hivemind is the public MCP entrypoint.
# Long stays derived-only / non-authoritative (ADR-0010): it is never a commit,
# rollback, audit, tombstone, watermark, membership or recovery source.

# --- Neo4j (graph store) — REQUIRED ---
# The stack will NOT start without a Neo4j password. Use a strong random value.
NEO4J_PASSWORD=
NEO4J_USER=neo4j
# NEO4J_URI is set by compose to bolt://neo4j:7687 (internal service).

# --- Qdrant (vector store) ---
# QDRANT_URL is set by compose to http://qdrant:6333 (internal service).
# Optional API key (leave empty unless you enable Qdrant auth in compose).
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=memory_

# --- Embedding model used by the long runtime ---
# Replace BOTH values for your provider before long ingestion or query.
# LLMAAS_EMBEDDING_MODEL must be accepted by `/embeddings`.
# LLMAAS_EMBEDDING_DIMENSIONS must equal the vector length that model actually
# returns. A mismatch fails writes/search; changing it for an existing Qdrant
# collection requires a reviewed rebuild/re-ingestion.
LLMAAS_EMBEDDING_MODEL=bge-m3:567m
LLMAAS_EMBEDDING_DIMENSIONS=1024

# --- Hivemind <-> embedded long binding ---
# Internal service URL: MUST be the compose service hostname, not an IP literal
# (an IP would trip Hivemind's SSRF guard). Consumed by the internal auto-bind.
LONG_EMBEDDED_URL=http://graph-memory:8002
# Local-only secret Hivemind presents to the embedded long runtime. LEAVE EMPTY
# for the default install: before readiness Hivemind atomically creates a
# dedicated scoped internal token in the local secret volume, persists it 0600
# so it survives restarts, and registers its hash with read+write only (never
# admin). Startup fails closed if durable persistence or registration is unsafe.
# Set this only to pin/rotate the secret yourself. Must NOT equal '__embedded__'
# (reserved sentinel). Never written into shared metadata, commits, shared-state
# backups, or audit payloads (ADR-0010 / ADR-0012).
LONG_EMBEDDED_TOKEN=
# The default Compose path is fixed to this value so its isolated initializer can
# validate the volume without receiving secrets or environment. Changing this
# .env line alone does not override Compose. Non-Compose/custom deployments may
# choose another LOCAL Linux path on ext4, XFS, Btrfs, tmpfs, or overlayfs; the
# parent must be 0700 and the secret 0600. Network/unknown filesystems fail closed.
LONG_EMBEDDED_TOKEN_FILE=/data/secrets/long_embedded_token

# --- Unified token authority (Model B) ---
# The embedded long runtime validates the SAME tokens as Hivemind by reading
# Hivemind's token store from shared S3 — one token system end-to-end. The long
# binding uses a DEDICATED, scoped, revocable internal token (auto-registered,
# read+write, never admin) — NOT ADMIN_BOOTSTRAP_KEY (which would bypass the S3
# validator via the GM bootstrap branch and over-grant admin). Token store key:
HIVEMIND_TOKENS_S3_KEY=_system/tokens.json
# Any Graph Memory memory_ids scoping is an internal namespace detail behind
# Hivemind's mono-tenant contract (ADR-0003), never an OSS tenancy boundary.
