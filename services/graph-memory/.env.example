# Hivemind embedded long runtime — environment reference
#
# This service is an internal, derived component of the root Docker Compose
# stack. Do not expose it to agents, publish its port, or run this file as a
# second standalone MCP deployment. Configure the root ../../.env instead;
# Compose supplies the storage, LLM, datastore, and shared token-authority
# values and keeps this service on the internal network.
#
# Values below are intentionally non-secret or blank. Never commit credentials.

# Source-document storage used by the derived long runtime.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=hivemind
S3_REGION_NAME=us-east-1

# Inference provider. This runtime resolves the SAME configuration families as
# the Hivemind core through the shared boundary (P13-1C, ADR-0027): either the
# legacy unified `LLMAAS_*` block below, or the split `INFERENCE_CHAT_*` /
# `INFERENCE_EMBEDDING_*` families — never a mixture (startup fails on any
# coexistence). It no longer carries its own provider defaults, so the values
# come from the shared root `../../.env`. The model ids below are illustrative,
# not portable: replace them with exact ids published by your provider.
# LLMAAS_EMBEDDING_DIMENSIONS must equal the vector length actually returned;
# changing it after ingestion requires a reviewed collection rebuild.
LLMAAS_API_URL=
LLMAAS_API_KEY=
LLMAAS_MODEL=qwen3.5:27b
LLMAAS_MAX_TOKENS=16384
LLMAAS_TEMPERATURE=0.3
LLMAAS_EMBEDDING_MODEL=bge-m3:567m
LLMAAS_EMBEDDING_DIMENSIONS=1024

# Internal datastores. Compose provides these service-local addresses.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
# The Qdrant instance is exclusive to this Hivemind deployment; sharing it is
# unsupported. This prefix probes legacy names only and never scopes canonical
# names. A non-default value emits one fixed, redacted FutureWarning per process.
QDRANT_COLLECTION_PREFIX=memory_

# Internal MCP identity. Hivemind is the only public MCP entrypoint.
MCP_SERVER_NAME=hivemind-graph-memory
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8002
MCP_SERVER_DEBUG=false

# Shared Hivemind token authority. Compose supplies the real bootstrap value;
# localhost bypass stays disabled. Agents never receive a separate long token.
ADMIN_BOOTSTRAP_KEY=
LOCALHOST_AUTH_BYPASS=false
HIVEMIND_TOKENS_S3_KEY=_system/tokens.json

# Outbound HTTP proxy (optional). Same Hivemind PROXY_URL as the core —
# configure it in the root ../../.env only; the shared Compose env_file
# delivers it here. When set, every Internet-bound request of this service
# (extraction/embedding LLM calls with their provider-health probes,
# document-storage S3, shared token-store S3 reads) uses the proxy and fails
# closed on proxy failure. Neo4j, Qdrant, the internal MCP bridge, and local
# health checks always stay direct. Never set HTTP_PROXY/HTTPS_PROXY instead.
PROXY_URL=

# Processing bounds (optional defaults shown for operator review).
MAX_DOCUMENT_SIZE_MB=50
EXTRACTION_TIMEOUT_SECONDS=600
S3_UPLOAD_TIMEOUT_SECONDS=60
# Positive critical Document-schema query/total deadline; optional DDL is shorter.
NEO4J_QUERY_TIMEOUT_SECONDS=30
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RAG_SCORE_THRESHOLD=0.58
RAG_CHUNK_LIMIT=8
