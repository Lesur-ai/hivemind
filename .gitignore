# === Embedded Graph Memory runtime (services/graph-memory/) ===
# Caches / venvs / secrets are already covered by the global Python + secret
# rules above (they match at any depth). These cover datastore volumes if an
# operator ever runs the embedded service standalone with bind mounts; the
# default compose uses named volumes (P7-2), so these normally never appear.
neo4j_data/
neo4j_logs/
qdrant_data/
qdrant_snapshots/

# === P8-7 admin console proof harness output (scripts/admin_console_proof.py) ===
# Screenshots + proof-report.json are attached to the PR, never committed, so the
# head SHA stays stable across proof re-runs.
proof-artifacts/
